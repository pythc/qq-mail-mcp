# Copy to .env; never commit the real .env.
QQ_MCP_PUBLIC_URL=http://localhost:8000
# Docker/Caddy only: set your domain and an HTTPS QQ_MCP_PUBLIC_URL for deployment.
DOMAIN=mail.example.com
QQ_MCP_HOST=127.0.0.1
QQ_MCP_PORT=8000
# Generate with: uv run qq-mail-mcp generate-secrets
QQ_MCP_ADMIN_PASSWORD=
QQ_MCP_ENCRYPTION_KEY=
QQ_MCP_DATABASE=data/qq-mail.sqlite3
# Enable only if outgoing mail is desired.
QQ_MCP_ALLOW_SEND=false
# Set false for direct sending after OAuth authorization (no per-email browser approval).
QQ_MCP_REQUIRE_SEND_APPROVAL=true
# Bind the account in the browser. Alternatively supply both environment variables.
QQ_EMAIL=
QQ_AUTH_CODE=
